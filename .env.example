# Composio project API key (dashboard.composio.dev → Settings → API keys)
COMPOSIO_API_KEY=
# Google AI Studio key (aistudio.google.com/apikey), free tier is fine
GEMINI_API_KEY=
# Optional: override the editor model (defaults to gemini-2.5-flash)
GEMINI_MODEL=
# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=
# Optional: public base URL used for OAuth callbacks (defaults to the request origin)
NEXT_PUBLIC_SITE_URL=
